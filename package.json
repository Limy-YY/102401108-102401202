{
  "name": "campus-lost-found",
  "version": "1.0.0",
  "private": true,
  "description": "校园失物招领（uni-app Vue3，命令行运行 H5）",
  "scripts": {
    "dev:h5": "node scripts/run.js",
    "build:h5": "node scripts/run.js build",
    "prebuild:h5": "node --test \"test/*.test.js\"",
    "test": "node --test \"test/*.test.js\"",
    "test:component": "vitest run",
    "test:e2e": "node scripts/run.js build && playwright test",
    "test:all": "npm test && npm run test:component && npm run test:e2e"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-alpha-5030120260930001",
    "@dcloudio/uni-components": "3.0.0-alpha-5030120260930001",
    "@dcloudio/uni-h5": "3.0.0-alpha-5030120260930001",
    "vue": "^3.4.21"
  },
  "devDependencies": {
    "@dcloudio/uni-cli-shared": "3.0.0-alpha-5030120260930001",
    "@dcloudio/vite-plugin-uni": "3.0.0-alpha-5030120260930001",
    "@playwright/test": "^1.63.0",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^20.14.5",
    "vite": "^5.2.8",
    "vitest": "^2.1.9"
  }
}
